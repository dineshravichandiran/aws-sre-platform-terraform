data "aws_region" "current" {}

locals {
  error_budget = 1 - var.slo_target # 0.001 for a 99.9% objective

  # Multiwindow, multi-burn-rate alerting (Google SRE Workbook):
  #   a burn rate of 1 uses the whole 30-day budget in exactly 30 days.
  #   14.4x for 1h  = 2% of the monthly budget gone in one hour  -> page now
  #   6x    for 6h  = 5% of the monthly budget gone in six hours -> page, slower
  # Each rule needs a long window AND a short window to agree. The long window proves the
  # problem is real, the short one proves it is still happening, so alerts clear quickly.
  windows = {
    fast-long  = { period = 3600, burn = 14.4, tier = "fast" }
    fast-short = { period = 300, burn = 14.4, tier = "fast" }
    slow-long  = { period = 21600, burn = 6, tier = "slow" }
    slow-short = { period = 1800, burn = 6, tier = "slow" }
  }

  alb_dimensions = { LoadBalancer = var.alb_arn_suffix }
}

resource "aws_sns_topic" "alerts" {
  #checkov:skip=CKV_AWS_26:The AWS-managed SNS key does not let CloudWatch publish to the topic, so an encrypted topic needs a customer-managed key with a CloudWatch statement. Listed in README as a next step.
  name = "${var.name}-slo-alerts"

  tags = var.tags
}

resource "aws_sns_topic_subscription" "email" {
  count = var.alarm_email == null ? 0 : 1

  topic_arn = aws_sns_topic.alerts.arn
  protocol  = "email"
  endpoint  = var.alarm_email
}

# ---- SLI: share of requests that did not fail on the server side ----
# Errors are 5xx from the targets plus 5xx generated by the load balancer itself
# (for example 503 when no target is healthy).

resource "aws_cloudwatch_metric_alarm" "burn" {
  for_each = local.windows

  alarm_name          = "${var.name}-slo-burn-${each.key}"
  alarm_description   = "Error ratio over ${each.value.period / 60} minutes is above ${each.value.burn}x the budget for a ${var.slo_target * 100}% objective."
  comparison_operator = "GreaterThanThreshold"
  evaluation_periods  = 1
  threshold           = each.value.burn * local.error_budget
  treat_missing_data  = "notBreaching" # no traffic means no errors, not an outage

  metric_query {
    id = "target_5xx"
    metric {
      namespace   = "AWS/ApplicationELB"
      metric_name = "HTTPCode_Target_5XX_Count"
      dimensions  = local.alb_dimensions
      period      = each.value.period
      stat        = "Sum"
    }
  }

  metric_query {
    id = "elb_5xx"
    metric {
      namespace   = "AWS/ApplicationELB"
      metric_name = "HTTPCode_ELB_5XX_Count"
      dimensions  = local.alb_dimensions
      period      = each.value.period
      stat        = "Sum"
    }
  }

  metric_query {
    id = "requests"
    metric {
      namespace   = "AWS/ApplicationELB"
      metric_name = "RequestCount"
      dimensions  = local.alb_dimensions
      period      = each.value.period
      stat        = "Sum"
    }
  }

  metric_query {
    id          = "error_ratio"
    expression  = "IF(requests > 0, (FILL(target_5xx, 0) + FILL(elb_5xx, 0)) / requests, 0)"
    label       = "5xx ratio"
    return_data = true
  }

  tags = var.tags
}

resource "aws_cloudwatch_composite_alarm" "page_fast" {
  alarm_name        = "${var.name}-slo-page-fast"
  alarm_description = "Fast burn: 14.4x budget over 1h and 5m. About 2% of the monthly error budget is gone in an hour. Page now. See docs/slo/RUNBOOK-high-burn.md."
  alarm_rule        = "ALARM(${aws_cloudwatch_metric_alarm.burn["fast-long"].alarm_name}) AND ALARM(${aws_cloudwatch_metric_alarm.burn["fast-short"].alarm_name})"
  alarm_actions     = [aws_sns_topic.alerts.arn]
  ok_actions        = [aws_sns_topic.alerts.arn]

  tags = var.tags
}

resource "aws_cloudwatch_composite_alarm" "page_slow" {
  alarm_name        = "${var.name}-slo-page-slow"
  alarm_description = "Slow burn: 6x budget over 6h and 30m. About 5% of the monthly error budget is gone in six hours. See docs/slo/RUNBOOK-high-burn.md."
  alarm_rule        = "ALARM(${aws_cloudwatch_metric_alarm.burn["slow-long"].alarm_name}) AND ALARM(${aws_cloudwatch_metric_alarm.burn["slow-short"].alarm_name})"
  alarm_actions     = [aws_sns_topic.alerts.arn]
  ok_actions        = [aws_sns_topic.alerts.arn]

  tags = var.tags
}

# ---- Latency SLI: p99 response time ----

resource "aws_cloudwatch_metric_alarm" "latency" {
  alarm_name          = "${var.name}-slo-latency-p99"
  alarm_description   = "p99 response time above ${var.latency_slo_seconds}s for 5 of the last 5 minutes."
  namespace           = "AWS/ApplicationELB"
  metric_name         = "TargetResponseTime"
  dimensions          = local.alb_dimensions
  extended_statistic  = "p99"
  period              = 60
  evaluation_periods  = 5
  datapoints_to_alarm = 5
  comparison_operator = "GreaterThanThreshold"
  threshold           = var.latency_slo_seconds
  treat_missing_data  = "notBreaching"
  alarm_actions       = [aws_sns_topic.alerts.arn]
  ok_actions          = [aws_sns_topic.alerts.arn]

  tags = var.tags
}

# ---- Dashboard ----

resource "aws_cloudwatch_dashboard" "slo" {
  dashboard_name = "${var.name}-slo"

  dashboard_body = jsonencode({
    widgets = [
      {
        type = "metric", x = 0, y = 0, width = 12, height = 6
        properties = {
          title  = "Requests and server errors (per minute)"
          region = data.aws_region.current.region
          stat   = "Sum"
          period = 60
          metrics = [
            ["AWS/ApplicationELB", "RequestCount", "LoadBalancer", var.alb_arn_suffix],
            [".", "HTTPCode_Target_5XX_Count", ".", "."],
            [".", "HTTPCode_ELB_5XX_Count", ".", "."],
          ]
        }
      },
      {
        type = "metric", x = 12, y = 0, width = 12, height = 6
        properties = {
          title  = "5xx ratio against the budget line"
          region = data.aws_region.current.region
          period = 300
          metrics = [
            [{ expression = "IF(r > 0, (FILL(t, 0) + FILL(e, 0)) / r, 0)", label = "5xx ratio", id = "ratio" }],
            ["AWS/ApplicationELB", "RequestCount", "LoadBalancer", var.alb_arn_suffix, { id = "r", stat = "Sum", visible = false }],
            [".", "HTTPCode_Target_5XX_Count", ".", ".", { id = "t", stat = "Sum", visible = false }],
            [".", "HTTPCode_ELB_5XX_Count", ".", ".", { id = "e", stat = "Sum", visible = false }],
          ]
          annotations = {
            horizontal = [
              { label = "error budget (${var.slo_target * 100}% objective)", value = local.error_budget },
              { label = "fast burn threshold (14.4x)", value = 14.4 * local.error_budget },
            ]
          }
        }
      },
      {
        type = "metric", x = 0, y = 6, width = 12, height = 6
        properties = {
          title  = "p99 response time (seconds)"
          region = data.aws_region.current.region
          period = 60
          metrics = [
            ["AWS/ApplicationELB", "TargetResponseTime", "LoadBalancer", var.alb_arn_suffix, { stat = "p99" }],
          ]
          annotations = {
            horizontal = [{ label = "latency objective", value = var.latency_slo_seconds }]
          }
        }
      },
      {
        type = "metric", x = 12, y = 6, width = 12, height = 6
        properties = {
          title  = "Healthy and unhealthy targets"
          region = data.aws_region.current.region
          period = 60
          metrics = [
            ["AWS/ApplicationELB", "HealthyHostCount", "TargetGroup", var.target_group_arn_suffix, "LoadBalancer", var.alb_arn_suffix, { stat = "Minimum" }],
            [".", "UnHealthyHostCount", ".", ".", ".", ".", { stat = "Maximum" }],
          ]
        }
      },
      {
        type = "alarm", x = 0, y = 12, width = 24, height = 3
        properties = {
          title = "SLO alerts"
          alarms = [
            aws_cloudwatch_composite_alarm.page_fast.arn,
            aws_cloudwatch_composite_alarm.page_slow.arn,
            aws_cloudwatch_metric_alarm.latency.arn,
          ]
        }
      },
    ]
  })
}
